# OMDb API — get a free key at https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_key_here

# Firebase — get these from Firebase console > Project settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini API key for the /chat feature — server-side only, never exposed to the browser.
# Get a free key (no credit card required) at aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here
